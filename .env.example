# ============================================================
# OptiRev - Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long

# Server
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# ML Service
ML_SERVICE_URL=http://ml-service:8000

# Email (SMTP) - Required for real email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@optirev.com

# S3-compatible Storage (MinIO, AWS S3, etc.)
# Leave blank for local disk storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=optirev-bucket
S3_ENDPOINT=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# Stripe (optional — self-serve mode if blank)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
